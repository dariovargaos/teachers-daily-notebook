rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: each teacher can only read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // Students roster: only the teacher who owns the record can access it
    match /students/{studentId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
    }

    // Reminders: only the teacher who owns the record can access it
    match /reminders/{reminderId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
    }

    // Planner notes: only the teacher who owns the record can access it
    match /plannerNotes/{noteId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
    }
  }
}
